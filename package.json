{
  "name": "funding-closeout",
  "version": "0.11.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "dev": "node server/start.ts",
    "start": "node server/start.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --write api src server web tests e2e docs *.json *.md *.ts",
    "format:check": "prettier --check api src server web tests e2e docs *.json *.md *.ts",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm run typecheck && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "axe-core": "4.14.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "zod": "4.6.6"
  },
  "dependencies": {
    "@types/node": "24.19.2",
    "@vercel/blob": "2.9.0"
  }
}
